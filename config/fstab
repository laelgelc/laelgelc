# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point> <type> <options> <dump> <pass>

# Root filesystem (/ was on /dev/nvme0n1p2 during curtin installation)
/dev/disk/by-uuid/631eb37f-9596-4ecb-803a-7eaf255fcb51 / ext4 defaults 0 1

# EFI System Partition (/boot/efi was on /dev/nvme0n1p1 during curtin installation)
/dev/disk/by-uuid/65C8-003E /boot/efi vfat defaults 0 1

# Swap file
/swap.img none swap sw 0 0

# Seagate 1TB external HDD - Ubuntu development partition
#UUID=7da42a41-7d99-487c-a6fd-014308e855c8 /mnt/UbuntuData ext4 defaults,nofail 0 2
